        local boxStroke = stroke(box, CurrentTheme.Outline, 1, 0.3)
        pad(box, 0, 0, 10, 10)

        box.Focused:Connect(function() tw(boxStroke, TI.Fast, { Color = CurrentTheme.Accent }) end)
        box.FocusLost:Connect(function(enter)
            tw(boxStroke, TI.Fast, { Color = CurrentTheme.Outline })
            safe(cfg.Callback, box.Text, enter)
        end)

        return {
            Frame = holder,
            Set = function(_, v) box.Text = v end,
            Get = function() return box.Text end,
        }
    end

    function Tab:CreateKeybind(cfg)
        cfg = cfg or {}
        local holder = baseElement(self, 44)
        local key = cfg.CurrentKeybind or cfg.Default or Enum.KeyCode.E
        local listening = false

        mk("TextLabel", {
            Parent = holder, BackgroundTransparency = 1,
            Position = UDim2.new(0, 18, 0, 0),
            Size = UDim2.new(1, -120, 1, 0),
            Font = Enum.Font.GothamMedium, Text = cfg.Name or "Keybind",
            TextColor3 = CurrentTheme.Text, TextSize = 13,
            TextXAlignment = Enum.TextXAlignment.Left,
        })

        local btn = mk("TextButton", {
            Parent = holder,
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -18, 0.5, 0),
            Size = UDim2.new(0, 80, 0, 30),
            BackgroundColor3 = CurrentTheme.ElementBg,
            BorderSizePixel = 0, Text = key.Name,
            Font = Enum.Font.GothamBold, TextColor3 = CurrentTheme.Text,
            TextSize = 12, AutoButtonColor = false,
        })
        corner(btn, 6)
        stroke(btn, CurrentTheme.Outline, 1, 0.3)

        local function stopListening()
            listening = false
            btn.Text = key.Name
            tw(btn, TI.Fast, { BackgroundColor3 = CurrentTheme.ElementBg })
        end

        btn.MouseButton1Click:Connect(function()
            listening = not listening
            if listening then
                btn.Text = "..."
                tw(btn, TI.Fast, { BackgroundColor3 = CurrentTheme.Accent })
            else
                stopListening()
            end
        end)

        UIS.InputBegan:Connect(function(input, gpe)
            if listening and input.UserInputType == Enum.UserInputType.Keyboard then
                key = input.KeyCode
                stopListening()
                if cfg.Flag then NoHorizon.Flags[cfg.Flag] = key end
                safe(cfg.Callback, key)
            elseif not gpe and input.KeyCode == key then
                safe(cfg.OnPressed)
            end
        end)
        UIS.InputEnded:Connect(function(input, gpe)
            if not gpe and input.KeyCode == key then safe(cfg.OnReleased) end
        end)

        return {
            Frame = holder,
            Set = function(_, k) key = k; btn.Text = k.Name end,
            Get = function() return key end,
        }
    end

    function Tab:CreateColorPicker(cfg)
        cfg = cfg or {}
        local holder = baseElement(self, 44)
        local color = cfg.Color or cfg.Default or Color3.fromRGB(255, 255, 255)
        local h, s, v = Color3.toHSV(color)
        local open = false

        mk("TextLabel", {
            Parent = holder, BackgroundTransparency = 1,
            Position = UDim2.new(0, 18, 0, 0),
            Size = UDim2.new(1, -110, 1, 0),
            Font = Enum.Font.GothamMedium, Text = cfg.Name or "Color",
            TextColor3 = CurrentTheme.Text, TextSize = 13,
            TextXAlignment = Enum.TextXAlignment.Left,
        })

        local preview = mk("Frame", {
            Parent = holder,
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -18, 0.5, 0),
            Size = UDim2.new(0, 70, 0, 28),
            BackgroundColor3 = color,
            BorderSizePixel = 0,
        })
        corner(preview, 6)
        stroke(preview, CurrentTheme.Outline, 1, 0.3)

        local pickerHolder = mk("Frame", {
            Parent = holder,
            Position = UDim2.new(0, 0, 1, 8),
            Size = UDim2.new(1, 0, 0, 0),
            BackgroundColor3 = CurrentTheme.ElementBg,
            BorderSizePixel = 0, Visible = false,
            ClipsDescendants = true,
        })
        corner(pickerHolder, 8)

        local svArea = mk("Frame", {
            Parent = pickerHolder,
            Position = UDim2.new(0, 14, 0, 14),
            Size = UDim2.new(1, -28, 0, 80),
            BackgroundColor3 = Color3.fromHSV(h, 1, 1),
            BorderSizePixel = 0,
        })
        corner(svArea, 6)

        local whiteGrad = mk("Frame", {
            Parent = svArea, Size = UDim2.new(1, 0, 1, 0),
            BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
        })
        corner(whiteGrad, 6)
        mk("UIGradient", {
            Parent = whiteGrad,
            Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 0),
                NumberSequenceKeypoint.new(1, 1),
            }),
        })

        local blackGrad = mk("Frame", {
            Parent = svArea, Size = UDim2.new(1, 0, 1, 0),
            BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
        })
        corner(blackGrad, 6)
        mk("UIGradient", {
            Parent = blackGrad, Rotation = 90,
            Color = ColorSequence.new(Color3.new(0, 0, 0), Color3.new(1, 1, 1)),
        })

        local svCursor = mk("Frame", {
            Parent = svArea,
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(s, 0, 1 - v, 0),
            Size = UDim2.new(0, 10, 0, 10),
            BackgroundColor3 = Color3.new(1, 1, 1),
            BorderSizePixel = 0, ZIndex = 2,
        })
        corner(svCursor, 5)
        stroke(svCursor, Color3.new(0, 0, 0), 2)

        local hueBar = mk("Frame", {
            Parent = pickerHolder,
            Position = UDim2.new(0, 14, 0, 102),
            Size = UDim2.new(1, -28, 0, 12),
            BackgroundColor3 = Color3.new(1, 1, 1),
            BorderSizePixel = 0,
        })
        corner(hueBar, 6)
        mk("UIGradient", {
            Parent = hueBar,
            Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0.000, Color3.fromRGB(255, 0, 0)),
                ColorSequenceKeypoint.new(0.167, Color3.fromRGB(255, 255, 0)),
                ColorSequenceKeypoint.new(0.333, Color3.fromRGB(0, 255, 0)),
                ColorSequenceKeypoint.new(0.500, Color3.fromRGB(0, 255, 255)),
                ColorSequenceKeypoint.new(0.667, Color3.fromRGB(0, 0, 255)),
                ColorSequenceKeypoint.new(0.833, Color3.fromRGB(255, 0, 255)),
                ColorSequenceKeypoint.new(1.000, Color3.fromRGB(255, 0, 0)),
            }),
        })

        local hueCursor = mk("Frame", {
            Parent = hueBar,
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(h, 0, 0.5, 0),
            Size = UDim2.new(0, 8, 0, 18),
            BackgroundColor3 = Color3.new(1, 1, 1),
            BorderSizePixel = 0, ZIndex = 2,
        })
        corner(hueCursor, 3)
        stroke(hueCursor, Color3.new(0, 0, 0), 1)

        local hexBox = mk("TextBox", {
            Parent = pickerHolder,
            Position = UDim2.new(0, 14, 0, 122),
            Size = UDim2.new(1, -28, 0, 24),
            BackgroundColor3 = CurrentTheme.CardBg,
            BorderSizePixel = 0,
            Font = Enum.Font.Code,
            Text = "#" .. string.format("%02X%02X%02X", color.R * 255, color.G * 255, color.B * 255),
            TextColor3 = CurrentTheme.Text, TextSize = 11,
            ClearTextOnFocus = false,
        })
        corner(hexBox, 4)
        pad(hexBox, 0, 0, 8, 8)

        local function commit()
            color = Color3.fromHSV(h, s, v)
            preview.BackgroundColor3 = color
            hexBox.Text = "#" .. string.format("%02X%02X%02X", color.R * 255, color.G * 255, color.B * 255)
            if cfg.Flag then NoHorizon.Flags[cfg.Flag] = color end
            safe(cfg.Callback, color)
        end

        hexBox.FocusLost:Connect(function()
            local hex = hexBox.Text:gsub("#", "")
            if #hex == 6 then
                local ok, r, g, b = pcall(function()
                    return tonumber(hex:sub(1, 2), 16), tonumber(hex:sub(3, 4), 16), tonumber(hex:sub(5, 6), 16)
                end)
                if ok and r and g and b then
                    color = Color3.fromRGB(r, g, b)
                    h, s, v = Color3.toHSV(color)
                    preview.BackgroundColor3 = color
                    svArea.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
                    svCursor.Position = UDim2.new(s, 0, 1 - v, 0)
                    hueCursor.Position = UDim2.new(h, 0, 0.5, 0)
                    commit()
                end
            end
        end)

        local svDrag, hDrag = false, false
        svArea.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                svDrag = true
            end
        end)
        hueBar.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                hDrag = true
            end
        end)
        UIS.InputChanged:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch then
                if svDrag then
                    local rx = math.clamp((i.Position.X - svArea.AbsolutePosition.X) / svArea.AbsoluteSize.X, 0, 1)
                    local ry = math.clamp((i.Position.Y - svArea.AbsolutePosition.Y) / svArea.AbsoluteSize.Y, 0, 1)
                    s, v = rx, 1 - ry
                    svCursor.Position = UDim2.new(s, 0, 1 - v, 0)
                    commit()
                end
                if hDrag then
                    local rx = math.clamp((i.Position.X - hueBar.AbsolutePosition.X) / hueBar.AbsoluteSize.X, 0, 1)
                    h = rx
                    hueCursor.Position = UDim2.new(h, 0, 0.5, 0)
                    svArea.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
                    commit()
                end
            end
        end)
        UIS.InputEnded:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                svDrag, hDrag = false, false
            end
        end)

        preview.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 then
                open = not open
                if open then
                    pickerHolder.Visible = true
                    holder:TweenSize(UDim2.new(1, 0, 0, 44 + 160), Enum.EasingDirection.Out, Enum.EasingStyle.Quart, 0.25, true)
                    tw(pickerHolder, TI.Normal, { Size = UDim2.new(1, 0, 0, 160) })
                else
                    tw(pickerHolder, TI.Normal, { Size = UDim2.new(1, 0, 0, 0) })
                    holder:TweenSize(UDim2.new(1, 0, 0, 44), Enum.EasingDirection.Out, Enum.EasingStyle.Quart, 0.25, true)
                    task.wait(0.25); pickerHolder.Visible = false
                end
            end
        end)

        return {
            Frame = holder,
            Set = function(_, c)
                color = c; h, s, v = Color3.toHSV(c)
                preview.BackgroundColor3 = c
                svArea.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
                svCursor.Position = UDim2.new(s, 0, 1 - v, 0)
                hueCursor.Position = UDim2.new(h, 0, 0.5, 0)
                hexBox.Text = "#" .. string.format("%02X%02X%02X", c.R * 255, c.G * 255, c.B * 255)
            end,
            Get = function() return color end,
        }
    end

    -- ═══════════════════════════════════════════════════
    -- SAVE MANAGER
    -- ═══════════════════════════════════════════════════
    if cfg.ConfigurationSaving and cfg.ConfigurationSaving.Enabled then
        local folder = cfg.ConfigurationSaving.FolderName or "NoHorizon"
        local file = cfg.ConfigurationSaving.FileName or "Config"

        function Window:Save()
            if not writefile_ then
                NoHorizon:Notify({ Title = "Save Error", Content = "writefile not supported.", Type = "error" })
                return
            end
            if isfolder_ and not isfolder_(folder) then pcall(makefolder_, folder) end
            local data = {}
            for k, val in pairs(NoHorizon.Flags) do
                if typeof(val) == "Color3" then
                    data[k] = { __t = "c3", r = val.R, g = val.G, b = val.B }
                elseif typeof(val) == "EnumItem" then
                    data[k] = { __t = "e", e = tostring(val.EnumType), n = val.Name }
                else
                    data[k] = val
                end
            end
            local ok, encoded = pcall(Http.JSONEncode, Http, data)
            if not ok then return end
            local ok2 = pcall(writefile_, folder .. "/" .. file .. ".json", encoded)
            if ok2 then NoHorizon:Notify({ Title = "Saved", Content = file .. " saved.", Type = "success" }) end
        end

        function Window:Load()
            if not readfile_ or not isfile_ then
                NoHorizon:Notify({ Title = "Load Error", Content = "readfile not supported.", Type = "error" })
                return
            end
            local path = folder .. "/" .. file .. ".json"
            if not isfile_(path) then
                NoHorizon:Notify({ Title = "Not Found", Content = file .. " doesn't exist.", Type = "warning" })
                return
            end
            local ok, content = pcall(readfile_, path)
            if not ok then return end
            local ok2, data = pcall(Http.JSONDecode, Http, content)
            if not ok2 then return end
            for k, val in pairs(data) do
                if type(val) == "table" and val.__t == "c3" then
                    NoHorizon.Flags[k] = Color3.new(val.r, val.g, val.b)
                elseif type(val) == "table" and val.__t == "e" then
                    local okE, enum = pcall(function() return Enum[val.e][val.n] end)
                    if okE then NoHorizon.Flags[k] = enum end
                else
                    NoHorizon.Flags[k] = val
                end
            end
            NoHorizon:Notify({ Title = "Loaded", Content = file .. " loaded.", Type = "success" })
        end
    end

    -- ═══════════════════════════════════════════════════
    -- WATERMARK
    -- ═══════════════════════════════════════════════════
    local wm = mk("Frame", {
        Parent = ScreenGui, Name = "Watermark",
        AnchorPoint = Vector2.new(0, 1),
        Position = UDim2.new(0, 16, 1, -16),
        Size = UDim2.new(0, 180, 0, 28),
        BackgroundColor3 = CurrentTheme.HeaderBg,
        BackgroundTransparency = 0.1,
        BorderSizePixel = 0, ZIndex = 400,
    })
    corner(wm, 8)
    stroke(wm, CurrentTheme.Outline, 1, 0.3)

    local wmAccent = mk("Frame", {
        Parent = wm, Size = UDim2.new(0, 3, 1, 0),
        BackgroundColor3 = CurrentTheme.Accent, BorderSizePixel = 0,
    })
    corner(wmAccent, 4)

    mk("TextLabel", {
        Parent = wm, BackgroundTransparency = 1,
        Position = UDim2.new(0, 14, 0, 0),
        Size = UDim2.new(1, -18, 1, 0),
        Font = Enum.Font.GothamBold,
        Text = windowName .. " • v" .. NoHorizon.Version,
        TextColor3 = CurrentTheme.Text, TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
    })

    makeDraggable(wm, wm)

    table.insert(NoHorizon.Windows, win)
    return win
end

-- ═══════════════════════════════════════════════════════════════
-- GLOBAL METHODS
-- ═══════════════════════════════════════════════════════════════
function NoHorizon:GetFlag(name) return self.Flags[name] end
function NoHorizon:SetFlag(name, value) self.Flags[name] = value end
function NoHorizon:Destroy()
    if self.ScreenGui then pcall(function() self.ScreenGui:Destroy() end) end
end

return NoHorizon
