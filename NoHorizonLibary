local Tooltip
local function initTooltip()
    if Tooltip and Tooltip.Parent then return end
    Tooltip = mk("TextLabel", {
        Parent = ScreenGui, Name = "Tooltip",
        BackgroundColor3 = CurrentTheme.CardBg,
        BackgroundTransparency = 0.1,
        BorderSizePixel = 0,
        Font = Enum.Font.Gotham, Text = "",
        TextColor3 = CurrentTheme.Text, TextSize = 11,
        TextWrapped = true,
        Size = UDim2.new(0, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.XY,
        Visible = false,
        ZIndex = 2000,
    })
    corner(Tooltip, 6)
    stroke(Tooltip, CurrentTheme.Outline, 1, 0.3)
    pad(Tooltip, 8)
end

local function attachTooltip(element, text)
    if not text or text == "" then return end
    initTooltip()
    element.MouseEnter:Connect(function()
        Tooltip.Text = text
        Tooltip.Visible = true
        Tooltip.TextTransparency = 1
        Tooltip.BackgroundTransparency = 1
        Tooltip.Position = UDim2.new(0, UIS:GetMouseLocation().X + 16, 0, UIS:GetMouseLocation().Y + 16)
        tw(Tooltip, TI.Fast, { TextTransparency = 0, BackgroundTransparency = 0.1 })
    end)
    element.MouseLeave:Connect(function()
        tw(Tooltip, TI.Fast, { TextTransparency = 1, BackgroundTransparency = 1 })
        task.wait(0.15)
        Tooltip.Visible = false
    end)
    UIS.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement and Tooltip.Visible then
            Tooltip.Position = UDim2.new(0, input.Position.X + 16, 0, input.Position.Y + 16)
        end
    end)
end

