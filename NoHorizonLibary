    function Tab:AddSlider(cfg, customContainer)
        cfg = cfg or {}
        local parent = customContainer or self.Container
        local min = cfg.Min or 0
        local max = cfg.Max or 100
        local state = math.clamp(cfg.Default or cfg.CurrentValue or min, min, max)
        local suffix = cfg.Suffix or ""
        local decimals = cfg.Decimals or 0

        local holder = mk("Frame", {
            Parent = parent,
            Size = UDim2.new(1, 0, 0, 60),
            BackgroundColor3 = CurrentTheme.CardBg,
            BorderSizePixel = 0,
        })
        corner(holder, 10)
        stroke(holder, CurrentTheme.Outline, 1, 0.4)

        mk("TextLabel", {
            Parent = holder, BackgroundTransparency = 1,
            Position = UDim2.new(0, 18, 0, 10),
            Size = UDim2.new(1, -90, 0, 16),
            Font = Enum.Font.GothamMedium, Text = cfg.Name or "Slider",
            TextColor3 = CurrentTheme.Text, TextSize = 13,
            TextXAlignment = Enum.TextXAlignment.Left,
        })

        local valLbl = mk("TextLabel", {
            Parent = holder, BackgroundTransparency = 1,
            Position = UDim2.new(1, -80, 0, 10),
            Size = UDim2.new(0, 60, 0, 16),
            Font = Enum.Font.GothamBold, Text = tostring(state) .. suffix,
            TextColor3 = CurrentTheme.Accent, TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Right,
        })

        local barBg = mk("Frame", {
            Parent = holder,
            Position = UDim2.new(0, 18, 0, 40),
            Size = UDim2.new(1, -36, 0, 6),
            BackgroundColor3 = CurrentTheme.ElementBg,
            BorderSizePixel = 0,
        })
        corner(barBg, 3)

        local fill = mk("Frame", {
            Parent = barBg, Size = UDim2.new(0, 0, 1, 0),
            BackgroundColor3 = CurrentTheme.Accent, BorderSizePixel = 0,
        })
        corner(fill, 3)
        gradient(fill, CurrentTheme.Accent, CurrentTheme.Accent2, 0)

        local knob = mk("Frame", {
            Parent = barBg,
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(0, 0, 0.5, 0),
            Size = UDim2.new(0, 14, 0, 14),
            BackgroundColor3 = Color3.new(1, 1, 1),
            BorderSizePixel = 0, ZIndex = 2,
        })
        corner(knob, 7)
        stroke(knob, CurrentTheme.Accent, 2)

        local dragging = false
        local function pct() return (state - min) / math.max(0.0001, (max - min)) end
        local function formatVal(v)
            if decimals == 0 then return tostring(math.floor(v + 0.5)) end
            return string.format("%." .. decimals .. "f", v)
        end
        local function update()
            local p = pct()
            tw(fill, TI.Fast, { Size = UDim2.new(p, 0, 1, 0) })
            tw(knob, TI.Fast, { Position = UDim2.new(p, 0, 0.5, 0) })
            valLbl.Text = formatVal(state) .. suffix
        end
        update()

        local function input(i)
            local rel = math.clamp((i.Position.X - barBg.AbsolutePosition.X) / barBg.AbsoluteSize.X, 0, 1)
            local nv = min + (max - min) * rel
            if decimals > 0 then
                nv = math.floor(nv * (10^decimals) + 0.5) / (10^decimals)
            else
                nv = math.floor(nv + 0.5)
            end
            if nv ~= state then
                state = nv; update()
                if cfg.Flag then
                    NoHorizon.Flags[cfg.Flag] = state
                    NoHorizon.Options[cfg.Flag] = { Value = state, Type = "Slider" }
                end
                safe(cfg.Callback, state)
            end
        end

        barBg.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                dragging = true; input(i)
            end
        end)
        knob.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                dragging = true
            end
        end)
        UIS.InputChanged:Connect(function(i)
            if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
                input(i)
            end
        end)
        UIS.InputEnded:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)

        return {
            Frame = holder,
            Set = function(_, v) state = math.clamp(v, min, max); update() end,
            Get = function() return state end,
        }
    end

    function Tab:AddDropdown(cfg, customContainer)
        cfg = cfg or {}
        local parent = customContainer or self.Container
        local options = cfg.Values or cfg.Options or {}
        local state = cfg.Default or cfg.CurrentOption or (options[1])
        local multi = cfg.Multi or cfg.MultipleOptions or false
        local searchable = cfg.Searchable or (#options > 8)
        local open = false

        if multi and type(state) ~= "table" then state = {} end

        local holder = mk("Frame", {
            Parent = parent,
            Size = UDim2.new(1, 0, 0, 44),
            BackgroundTransparency = 1,
        })
        mk("UIListLayout", { Parent = holder, Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder })

        local btn = mk("TextButton", {
            Parent = holder, Size = UDim2.new(1, 0, 0, 44),
            BackgroundColor3 = CurrentTheme.CardBg,
            BorderSizePixel = 0, Text = "", AutoButtonColor = false,
        })
        corner(btn, 10)
        stroke(btn, CurrentTheme.Outline, 1, 0.4)

        mk("TextLabel", {
            Parent = btn, BackgroundTransparency = 1,
            Position = UDim2.new(0, 18, 0, 0),
            Size = UDim2.new(1, -100, 1, 0),
            Font = Enum.Font.GothamMedium, Text = cfg.Name or "Dropdown",
            TextColor3 = CurrentTheme.Text, TextSize = 13,
            TextXAlignment = Enum.TextXAlignment.Left,
        })

        local valLbl = mk("TextLabel", {
            Parent = btn, BackgroundTransparency = 1,
            Position = UDim2.new(1, -140, 0, 0),
            Size = UDim2.new(0, 112, 1, 0),
            Font = Enum.Font.Gotham, Text = multi and "None" or tostring(state),
            TextColor3 = CurrentTheme.SubText, TextSize = 11,
            TextXAlignment = Enum.TextXAlignment.Right,
        })

        local arrow = mk("TextLabel", {
            Parent = btn, BackgroundTransparency = 1,
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -14, 0.5, 0),
            Size = UDim2.new(0, 16, 1, 0),
            Font = Enum.Font.GothamBold, Text = "▾",
            TextColor3 = CurrentTheme.SubText, TextSize = 11,
        })

        local listHolder = mk("Frame", {
            Parent = holder, Size = UDim2.new(1, 0, 0, 0),
            BackgroundColor3 = CurrentTheme.CardBg,
            BorderSizePixel = 0, Visible = false,
            ClipsDescendants = true,
        })
        corner(listHolder, 10)
        stroke(listHolder, CurrentTheme.Outline, 1, 0.4)

        local listLayoutFrame = mk("Frame", {
            Parent = listHolder,
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
        })

        local searchBox = nil
        local topOffset = 0
        if searchable then
            searchBox = mk("TextBox", {
                Parent = listLayoutFrame,
                Size = UDim2.new(1, -12, 0, 28),
                Position = UDim2.new(0, 6, 0, 6),
                BackgroundColor3 = CurrentTheme.ElementBg,
                BorderSizePixel = 0,
                Font = Enum.Font.Gotham,
                PlaceholderText = "Search...",
                PlaceholderColor3 = CurrentTheme.Muted,
                Text = "", TextColor3 = CurrentTheme.Text,
                TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left,
                ClearTextOnFocus = false,
            })
            corner(searchBox, 6)
            pad(searchBox, 0, 0, 8, 8)
            topOffset = 38
        end

        local listScroll = mk("ScrollingFrame", {
            Parent = listLayoutFrame,
            Size = UDim2.new(1, 0, 1, -topOffset),
            Position = UDim2.new(0, 0, 0, topOffset),
            BackgroundTransparency = 1, BorderSizePixel = 0,
            ScrollBarThickness = 2,
            ScrollBarImageColor3 = CurrentTheme.Accent,
            CanvasSize = UDim2.new(0, 0, 0, 0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
        })
        mk("UIListLayout", { Parent = listScroll, Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder })
        pad(listScroll, 6, 6, 6, 6)

        local items = {}
        local function isSel(o)
            if multi then return table.find(state, o) ~= nil end
            return state == o
        end

        local function updateV()
            if multi then
                if #state == 0 then valLbl.Text = "None"
                elseif #state == 1 then valLbl.Text = state[1]
                else valLbl.Text = #state .. " selected" end
            else
                valLbl.Text = tostring(state)
            end
        end

        local function setSel(o, v)
            if multi then
                local idx = table.find(state, o)
                if v and not idx then table.insert(state, o)
                elseif not v and idx then table.remove(state, idx) end
            else
                state = o
            end
            updateV()
            if cfg.Flag then
                NoHorizon.Flags[cfg.Flag] = state
                NoHorizon.Options[cfg.Flag] = { Value = state, Type = "Dropdown" }
            end
            safe(cfg.Callback, state)
        end

        local function buildItems(filter)
            for _, it in ipairs(items) do it.item:Destroy() end
            items = {}
            filter = (filter or ""):lower()
            for _, optName in ipairs(options) do
                if filter == "" or string.find(tostring(optName):lower(), filter, 1, true) then
                    local item = mk("TextButton", {
                        Parent = listScroll, Size = UDim2.new(1, 0, 0, 30),
                        BackgroundColor3 = CurrentTheme.CardBg,
                        BorderSizePixel = 0, Text = "", AutoButtonColor = false,
                    })
                    corner(item, 6)

                    local check = mk("Frame", {
                        Parent = item, AnchorPoint = Vector2.new(1, 0.5),
                        Position = UDim2.new(1, -12, 0.5, 0),
                        Size = UDim2.new(0, 12, 0, 12),
                        BackgroundColor3 = isSel(optName) and CurrentTheme.Accent or CurrentTheme.ElementBg,
                        BorderSizePixel = 0, Visible = multi,
                    })
                    corner(check, 3)

                    local lbl = mk("TextLabel", {
                        Parent = item, BackgroundTransparency = 1,
                        Position = UDim2.new(0, 14, 0, 0),
                        Size = UDim2.new(1, -36, 1, 0),
                        Font = Enum.Font.Gotham, Text = tostring(optName),
                        TextColor3 = (not multi and isSel(optName)) and CurrentTheme.Accent or CurrentTheme.Text,
                        TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left,
                    })

                    item.MouseEnter:Connect(function() tw(item, TI.Fast, { BackgroundColor3 = CurrentTheme.CardHover }) end)
                    item.MouseLeave:Connect(function() tw(item, TI.Fast, { BackgroundColor3 = CurrentTheme.CardBg }) end)
                    item.MouseButton1Click:Connect(function()
                        if multi then
                            local nv = not isSel(optName)
                            setSel(optName, nv)
                            tw(check, TI.Fast, { BackgroundColor3 = nv and CurrentTheme.Accent or CurrentTheme.ElementBg })
                        else
                            setSel(optName, true)
                            for _, other in ipairs(items) do
                                other.lbl.TextColor3 = (other.name == optName) and CurrentTheme.Accent or CurrentTheme.Text
                            end
                            open = false
                            tw(arrow, TI.Fast, { Rotation = 0 })
                            tw(listHolder, TI.Normal, { Size = UDim2.new(1, 0, 0, 0) })
                            task.wait(0.2); listHolder.Visible = false
                        end
                    end)
                    table.insert(items, { item = item, lbl = lbl, name = optName, check = check })
                end
            end
        end

        buildItems()

        if searchBox then
            searchBox:GetPropertyChangedSignal("Text"):Connect(function() buildItems(searchBox.Text) end)
        end

        updateV()

        btn.MouseEnter:Connect(function() if not open then tw(btn, TI.Fast, { BackgroundColor3 = CurrentTheme.CardHover }) end end)
        btn.MouseLeave:Connect(function() if not open then tw(btn, TI.Fast, { BackgroundColor3 = CurrentTheme.CardBg }) end end)
        btn.MouseButton1Click:Connect(function()
            open = not open
            if open then
                listHolder.Visible = true
                local h = math.min(#options * 32 + 12, 180) + (searchable and 38 or 0)
                tw(listHolder, TI.Normal, { Size = UDim2.new(1, 0, 0, h) })
                tw(arrow, TI.Fast, { Rotation = 180 })
            else
                tw(arrow, TI.Fast, { Rotation = 0 })
                tw(listHolder, TI.Normal, { Size = UDim2.new(1, 0, 0, 0) })
                task.wait(0.2); listHolder.Visible = false
            end
        end)

        return {
            Frame = holder,
            Set = function(_, v) setSel(v, true) end,
            Get = function() return state end,
            Refresh = function(_, opts) options = opts; buildItems() end,
        }
    end

