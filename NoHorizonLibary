function NoHorizon:Notify(opts)
    opts = opts or {}
    local t = NoHorizon.CurrentTheme or NoHorizon.Themes.Default
    local title = opts.Title or "Notification"
    local content = opts.Content or ""
    local duration = opts.Duration or 5
    local kind = opts.Type or "info"
    local accent = t.Accent
    if kind == "success" then accent = Color3.fromRGB(80, 220, 130)
    elseif kind == "warning" then accent = Color3.fromRGB(255, 180, 60)
    elseif kind == "error" then accent = Color3.fromRGB(255, 80, 90) end

    local card = mk("Frame", {
        Parent = NotifHolder, Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundColor3 = t.Background, BorderSizePixel = 0,
    })
    crn(card, 8); str(card, t.Outline, 1); pad(card, 10)

    local bar = mk("Frame", {Parent=card, Size=UDim2.new(0,3,1,0), Position=UDim2.new(0,-10,0,0),
        BackgroundColor3=accent, BorderSizePixel=0})
    crn(bar, 4)

    mk("TextLabel", {Parent=card, BackgroundTransparency=1, Size=UDim2.new(1,0,0,16),
        Font=Enum.Font.GothamBold, Text=title, TextColor3=t.Title, TextSize=13,
        TextXAlignment=Enum.TextXAlignment.Left})
    mk("TextLabel", {Parent=card, BackgroundTransparency=1, Position=UDim2.new(0,0,0,18),
        Size=UDim2.new(1,0,0,0), AutomaticSize=Enum.AutomaticSize.Y,
        Font=Enum.Font.Gotham, Text=content, TextColor3=t.Subtitle, TextSize=11,
        TextWrapped=true, TextXAlignment=Enum.TextXAlignment.Left})

    card.Position = UDim2.new(1, 60, 0, 0)
    tw(card, Tween.Normal, {Position=UDim2.new(0,0,0,0)})
    task.delay(duration, function()
        if not card or not card.Parent then return end
        tw(card, Tween.Normal, {Position=UDim2.new(1,60,0,0), BackgroundTransparency=1})
        for _, c in ipairs(card:GetDescendants()) do
            if c:IsA("TextLabel") then tw(c, Tween.Normal, {TextTransparency=1}) end
            if c:IsA("Frame") then tw(c, Tween.Normal, {BackgroundTransparency=1}) end
        end
        task.wait(0.3); card:Destroy()
    end)
end

