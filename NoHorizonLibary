            AutomaticCanvasSize=Enum.AutomaticSize.Y})
        mk("UIListLayout", {Parent=listScroll, Padding=UDim.new(0,2), SortOrder=Enum.SortOrder.LayoutOrder})
        pad(listScroll, 4, 4, 4, 4)

        local items = {}
        local function isSel(o)
            if multi then return table.find(state, o) ~= nil end
            return state == o
        end

        local function updateV()
            if multi then
                if #state == 0 then valLbl.Text = "None"
                elseif #state == 1 then valLbl.Text = state[1]
                else valLbl.Text = #state .. " selected" end
            else valLbl.Text = tostring(state) end
        end

        local function setSel(o, v)
            if multi then
                local idx = table.find(state, o)
                if v and not idx then table.insert(state, o)
                elseif not v and idx then table.remove(state, idx) end
            else state = o end
            updateV()
            if cfg.Flag then NoHorizon.Flags[cfg.Flag] = state end
            safe(cfg.Callback, state)
        end

        for _, opt in ipairs(options) do
            local item = mk("TextButton", {Parent=listScroll, Size=UDim2.new(1,0,0,26),
                BackgroundColor3=t.Dropdown, BorderSizePixel=0, Text="", AutoButtonColor=false})
            crn(item, 4)
            local check = mk("Frame", {Parent=item, AnchorPoint=Vector2.new(1,0.5),
                Position=UDim2.new(1,-8,0.5,0), Size=UDim2.new(0,12,0,12),
                BackgroundColor3=isSel(opt) and t.Accent or t.Tab, BorderSizePixel=0,
                Visible=multi})
            crn(check, 3)
            local lbl = mk("TextLabel", {Parent=item, BackgroundTransparency=1,
                Position=UDim2.new(0,10,0,0), Size=UDim2.new(1,-30,1,0),
                Font=Enum.Font.Gotham, Text=tostring(opt),
                TextColor3=(not multi and isSel(opt)) and t.Accent or t.TextColor,
                TextSize=12, TextXAlignment=Enum.TextXAlignment.Left})

            item.MouseEnter:Connect(function() tw(item, Tween.Fast, {BackgroundColor3=t.Tab}) end)
            item.MouseLeave:Connect(function() tw(item, Tween.Fast, {BackgroundColor3=t.Dropdown}) end)
            item.MouseButton1Click:Connect(function()
                if multi then
                    local nv = not isSel(opt)
                    setSel(opt, nv)
                    tw(check, Tween.Fast, {BackgroundColor3=nv and t.Accent or t.Tab})
                else
                    setSel(opt, true)
                    for _, other in ipairs(items) do
                        other.lbl.TextColor3 = (other.name == opt) and t.Accent or t.TextColor
                    end
                    open = false
                    tw(arrow, Tween.Fast, {Rotation=0})
                    tw(listHolder, Tween.Normal, {Size=UDim2.new(1,0,0,0)})
                    task.wait(0.2); listHolder.Visible = false
                end
            end)
            table.insert(items, {item=item, lbl=lbl, name=opt, check=check})
        end

        updateV()

        btn.MouseButton1Click:Connect(function()
            open = not open
            if open then
                listHolder.Visible = true
                local h = math.min(#options * 28 + 8, 160)
                tw(listHolder, Tween.Normal, {Size=UDim2.new(1,0,0,h)})
                tw(arrow, Tween.Fast, {Rotation=180})
            else
                tw(arrow, Tween.Fast, {Rotation=0})
                tw(listHolder, Tween.Normal, {Size=UDim2.new(1,0,0,0)})
                task.wait(0.2); listHolder.Visible = false
            end
        end)

        return {
            Frame=holder,
            Set=function(_, v) setSel(v, true) end,
            Get=function() return state end,
            Refresh=function(_, opts) options = opts end,
        }
    end

