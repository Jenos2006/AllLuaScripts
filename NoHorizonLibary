function NoHorizon:Notify(opts)
    opts = opts or {}
    local title    = opts.Title or "Notification"
    local content  = opts.Content or ""
    local subContent = opts.SubContent
    local duration = opts.Duration or 5
    local kind     = opts.Type or "info"
    local icon     = opts.Icon

    local accent = CurrentTheme.Accent
    if kind == "success" then accent = CurrentTheme.Success
    elseif kind == "warning" then accent = CurrentTheme.Warning
    elseif kind == "error" then accent = CurrentTheme.Error end

    local card = mk("Frame", {
        Parent = NotifHolder,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundColor3 = CurrentTheme.CardBg,
        BackgroundTransparency = 0.05,
        BorderSizePixel = 0,
    })
    corner(card, 10)
    stroke(card, CurrentTheme.Outline, 1, 0.4)
    pad(card, 12, 12, 14, 12)

    local accentBar = mk("Frame", {
        Parent = card,
        Size = UDim2.new(0, 3, 1, 0),
        Position = UDim2.new(0, -12, 0, 0),
        BackgroundColor3 = accent,
        BorderSizePixel = 0,
    })
    corner(accentBar, 4)

    if icon then
        mk("ImageLabel", {
            Parent = card,
            BackgroundTransparency = 1,
            Position = UDim2.new(1, -20, 0, 0),
            Size = UDim2.new(0, 18, 0, 18),
            Image = icon,
            ImageColor3 = accent,
        })
    end

    mk("TextLabel", {
        Parent = card, BackgroundTransparency = 1,
        Size = UDim2.new(1, -30, 0, 16),
        Font = Enum.Font.GothamBold, Text = title,
        TextColor3 = CurrentTheme.Text, TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
    })

    mk("TextLabel", {
        Parent = card, BackgroundTransparency = 1,
        Position = UDim2.new(0, 0, 0, 18),
        Size = UDim2.new(1, -30, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        Font = Enum.Font.Gotham, Text = content,
        TextColor3 = CurrentTheme.SubText, TextSize = 11,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
    })

    if subContent then
        mk("TextLabel", {
            Parent = card, BackgroundTransparency = 1,
            Position = UDim2.new(0, 0, 0, 36),
            Size = UDim2.new(1, -30, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            Font = Enum.Font.Gotham, Text = subContent,
            TextColor3 = CurrentTheme.Muted, TextSize = 10,
            TextWrapped = true,
            TextXAlignment = Enum.TextXAlignment.Left,
        })
    end

    card.Position = UDim2.new(1, 60, 0, 0)
    card.BackgroundTransparency = 1
    tw(card, TI.Normal, { Position = UDim2.new(0, 0, 0, 0), BackgroundTransparency = 0.05 })

    task.delay(duration, function()
        if not card or not card.Parent then return end
        tw(card, TI.Normal, { Position = UDim2.new(1, 60, 0, 0), BackgroundTransparency = 1 })
        for _, child in ipairs(card:GetDescendants()) do
            if child:IsA("TextLabel") then tw(child, TI.Normal, { TextTransparency = 1 }) end
            if child:IsA("Frame") then tw(child, TI.Normal, { BackgroundTransparency = 1 }) end
            if child:IsA("ImageLabel") then tw(child, TI.Normal, { ImageTransparency = 1 }) end
        end
        task.wait(0.3)
        card:Destroy()
    end)
end

-- ═══════════════════════════════════════════════════════════════
-- DRAGGABLE
-- ═══════════════════════════════════════════════════════════════
local function makeDraggable(frame, handle)
    handle = handle or frame
    local dragging, dragStart, startPos
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
        end
    end)
    handle.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
            local d = input.Position - dragStart
            frame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + d.X,
                startPos.Y.Scale, startPos.Y.Offset + d.Y
            )
        end
    end)
end

