            item.MouseLeave:Connect(function() tw(item, TI.Fast, { BackgroundColor3 = CurrentTheme.CardBg }) end)
            item.MouseButton1Click:Connect(function()
                if multi then
                    local nv = not isSel(opt)
                    setSel(opt, nv)
                    tw(check, TI.Fast, { BackgroundColor3 = nv and CurrentTheme.Accent or CurrentTheme.ElementBg })
                else
                    setSel(opt, true)
                    for _, other in ipairs(items) do
                        other.lbl.TextColor3 = (other.name == opt) and CurrentTheme.Accent or CurrentTheme.Text
                    end
                    open = false
                    tw(arrow, TI.Fast, { Rotation = 0 })
                    tw(listHolder, TI.Normal, { Size = UDim2.new(1, 0, 0, 0) })
                    task.wait(0.2); listHolder.Visible = false
                end
            end)
            table.insert(items, { item = item, lbl = lbl, name = opt, check = check })
        end

        updateV()

        btn.MouseEnter:Connect(function() if not open then tw(btn, TI.Fast, { BackgroundColor3 = CurrentTheme.CardHover }) end end)
        btn.MouseLeave:Connect(function() if not open then tw(btn, TI.Fast, { BackgroundColor3 = CurrentTheme.CardBg }) end end)
        btn.MouseButton1Click:Connect(function()
            open = not open
            if open then
                listHolder.Visible = true
