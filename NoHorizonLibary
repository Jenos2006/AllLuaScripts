        })

        local container = mk("ScrollingFrame", {
            Parent = content, Name = tab.Name,
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1, BorderSizePixel = 0,
            ScrollBarThickness = 3,
            ScrollBarImageColor3 = CurrentTheme.Accent,
            ScrollBarImageTransparency = 0.6,
            CanvasSize = UDim2.new(0, 0, 0, 0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            Visible = false,
        })
        mk("UIListLayout", {
            Parent = container,
            Padding = UDim.new(0, 10),
            SortOrder = Enum.SortOrder.LayoutOrder,
        })
        pad(container, 18, 18, 18, 18)

        tab.Button = btn
        tab.Label = lbl
        tab.Icon = iconLbl
        tab.Container = container

        btn.MouseEnter:Connect(function()
            if self.ActiveTab ~= tab then
                tw(lbl, TI.Fast, { TextColor3 = CurrentTheme.Text })
                if iconLbl then tw(iconLbl, TI.Fast, { ImageColor3 = CurrentTheme.Text }) end
                tw(btn, TI.Fast, { BackgroundTransparency = 0.5, BackgroundColor3 = CurrentTheme.CardBg })
            end
        end)
        btn.MouseLeave:Connect(function()
            if self.ActiveTab ~= tab then
                tw(lbl, TI.Fast, { TextColor3 = CurrentTheme.SubText })
                if iconLbl then tw(iconLbl, TI.Fast, { ImageColor3 = CurrentTheme.SubText }) end
                tw(btn, TI.Fast, { BackgroundTransparency = 1 })
            end
        end)
        btn.MouseButton1Click:Connect(function()
            self:SelectTab(tab)
        end)

        table.insert(self.Tabs, tab)
        if #self.Tabs == 1 then
            self:SelectTab(tab)
        end

        return tab
    end

    function Window:SelectTab(tab)
        if self.ActiveTab == tab then return end
        local prev = self.ActiveTab
        self.ActiveTab = tab

        if prev then
            tw(prev.Label, TI.Fast, { TextColor3 = CurrentTheme.SubText })
            if prev.Icon then tw(prev.Icon, TI.Fast, { ImageColor3 = CurrentTheme.SubText }) end
            tw(prev.Button, TI.Fast, { BackgroundTransparency = 1, BackgroundColor3 = CurrentTheme.SidebarBg })
            if prev.Container.Visible then
                tw(prev.Container, TI.Fast, { Position = UDim2.new(0, -12, 0, 0) })
                task.wait(0.06)
                prev.Container.Visible = false
                prev.Container.Position = UDim2.new(0, 0, 0, 0)
            end
        end

        tw(tab.Label, TI.Fast, { TextColor3 = CurrentTheme.Text })
        if tab.Icon then tw(tab.Icon, TI.Fast, { ImageColor3 = CurrentTheme.Accent }) end
        tw(tab.Button, TI.Fast, { BackgroundTransparency = 0, BackgroundColor3 = CurrentTheme.CardBg })

        tab.Container.Visible = true
        tab.Container.Position = UDim2.new(0, 12, 0, 0)
        tw(tab.Container, TI.Normal, { Position = UDim2.new(0, 0, 0, 0) })
    end

