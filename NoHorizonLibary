local function showLoading(title, subtitle, duration)
    local bg = mk("Frame", {Parent=ScreenGui, Size=UDim2.new(1,0,1,0),
        BackgroundColor3=Color3.new(0,0,0), BackgroundTransparency=1, ZIndex=1000})
    local center = mk("Frame", {Parent=bg, AnchorPoint=Vector2.new(0.5,0.5),
        Position=UDim2.new(0.5,0,0.5,0), Size=UDim2.new(0,400,0,80),
        BackgroundTransparency=1, ZIndex=1001})
    local titleLbl = mk("TextLabel", {Parent=center, BackgroundTransparency=1,
        Size=UDim2.new(1,0,0,36), Font=Enum.Font.GothamBold, Text=title or "NoHorizon",
        TextColor3=Color3.new(1,1,1), TextSize=32, TextTransparency=1, ZIndex=1002})
    local subLbl = mk("TextLabel", {Parent=center, BackgroundTransparency=1,
        Position=UDim2.new(0,0,0,38), Size=UDim2.new(1,0,0,20),
        Font=Enum.Font.Gotham, Text=subtitle or "", TextColor3=Color3.fromRGB(180,180,180),
        TextSize=14, TextTransparency=1, ZIndex=1002})
    local barBg = mk("Frame", {Parent=center, Position=UDim2.new(0.5,-100,1,-6),
        Size=UDim2.new(0,200,0,3), BackgroundColor3=Color3.fromRGB(50,50,50),
        BackgroundTransparency=1, BorderSizePixel=0, ZIndex=1002})
    crn(barBg, 2)
    local barFill = mk("Frame", {Parent=barBg, Size=UDim2.new(0,0,1,0),
        BackgroundColor3=NoHorizon.Themes.Default.Accent, BorderSizePixel=0, ZIndex=1003})
    crn(barFill, 2)

    tw(bg, Tween.Slow, {BackgroundTransparency=0})
    tw(titleLbl, Tween.Slow, {TextTransparency=0})
    tw(subLbl, Tween.Slow, {TextTransparency=0})
    tw(barBg, Tween.Slow, {BackgroundTransparency=0})
    tw(barFill, TweenInfo.new(duration or 2, Enum.EasingStyle.Linear), {Size=UDim2.new(1,0,1,0)})
    task.wait((duration or 2) + 0.2)
    tw(bg, Tween.Normal, {BackgroundTransparency=1})
    tw(titleLbl, Tween.Normal, {TextTransparency=1})
    tw(subLbl, Tween.Normal, {TextTransparency=1})
    task.wait(0.2); bg:Destroy()
end

