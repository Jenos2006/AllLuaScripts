local function createKeySystem(cfg)
    local bg = mk("Frame", {Parent=ScreenGui, Size=UDim2.new(1,0,1,0),
        BackgroundColor3=Color3.fromRGB(15,15,15), ZIndex=2000})
    local box = mk("Frame", {Parent=bg, AnchorPoint=Vector2.new(0.5,0.5),
        Position=UDim2.new(0.5,0,0.5,0), Size=UDim2.new(0,360,0,180),
        BackgroundColor3=Color3.fromRGB(30,30,30), BorderSizePixel=0, ZIndex=2001})
    crn(box, 10); str(box, Color3.fromRGB(60,60,60), 1)

    mk("TextLabel", {Parent=box, BackgroundTransparency=1, Position=UDim2.new(0,0,0,20),
        Size=UDim2.new(1,0,0,28), Font=Enum.Font.GothamBold, Text="Key System",
        TextColor3=Color3.new(1,1,1), TextSize=20, ZIndex=2002})
    mk("TextLabel", {Parent=box, BackgroundTransparency=1, Position=UDim2.new(0,0,0,50),
        Size=UDim2.new(1,0,0,18), Font=Enum.Font.Gotham,
        Text="Please enter your key to continue", TextColor3=Color3.fromRGB(180,180,180),
        TextSize=12, ZIndex=2002})

    local input = mk("TextBox", {Parent=box, AnchorPoint=Vector2.new(0.5,0),
        Position=UDim2.new(0.5,0,0,85), Size=UDim2.new(0,300,0,34),
        BackgroundColor3=Color3.fromRGB(45,45,45), BorderSizePixel=0,
        Font=Enum.Font.Gotham, PlaceholderText="Enter Key...",
        PlaceholderColor3=Color3.fromRGB(120,120,120),
        Text="", TextColor3=Color3.new(1,1,1), TextSize=13,
        ClearTextOnFocus=false, ZIndex=2002})
    crn(input, 6); str(input, Color3.fromRGB(60,60,60), 1)
    pad(input, 0,0,10,10)

    local btn = mk("TextButton", {Parent=box, AnchorPoint=Vector2.new(0.5,0),
        Position=UDim2.new(0.5,0,0,128), Size=UDim2.new(0,300,0,32),
        BackgroundColor3=Color3.fromRGB(0,170,255), BorderSizePixel=0,
        Font=Enum.Font.GothamBold, Text="Submit", TextColor3=Color3.new(1,1,1),
        TextSize=13, AutoButtonColor=false, ZIndex=2002})
    crn(btn, 6)

    local status = mk("TextLabel", {Parent=box, BackgroundTransparency=1,
        Position=UDim2.new(0,0,1,-24), Size=UDim2.new(1,0,0,16),
        Font=Enum.Font.Gotham, Text="", TextColor3=Color3.fromRGB(255,80,80),
        TextSize=11, ZIndex=2002})

    local done = false
    local validKeys = cfg.Key or {}
    local function validate()
        local k = input.Text
        for _, valid in ipairs(validKeys) do
            if k == valid then
                done = true
                tw(bg, Tween.Normal, {BackgroundTransparency=1})
                task.wait(0.3); bg:Destroy()
                return
            end
        end
        status.Text = "Invalid key"
        tw(input, Tween.Fast, {BackgroundColor3=Color3.fromRGB(80,20,20)})
        task.wait(0.4)
        tw(input, Tween.Fast, {BackgroundColor3=Color3.fromRGB(45,45,45)})
    end

    btn.MouseButton1Click:Connect(validate)
    input.FocusLost:Connect(function(enter) if enter then validate() end end)

    while not done do task.wait(0.1) end
end

