        local max = cfg.Range and cfg.Range[2] or 100
        local state = math.clamp(cfg.CurrentValue or cfg.Default or min, min, max)
        local suffix = cfg.Suffix or ""

        local holder = baseElement(self, 60)

        mk("TextLabel", {
            Parent = holder, BackgroundTransparency = 1,
            Position = UDim2.new(0, 18, 0, 10),
