-- DPI SCALING
-- ═══════════════════════════════════════════════════════════════
local DPI_SCALE = 1
local function setScale(scale)
    DPI_SCALE = math.clamp(scale, 0.5, 1.5)
    if NoHorizon.ScreenGui then
        local win = NoHorizon.ScreenGui:FindFirstChild("Window")
        if win then
            local base = win:GetAttribute("BaseSize") or Vector2.new(660, 480)
            win.Size = UDim2.new(0, base.X * DPI_SCALE, 0, base.Y * DPI_SCALE)
        end
    end
end

