    local Tab = {}
    Tab.__index = Tab

    function Window:CreateTab(tabName, icon)
        local tab = setmetatable({}, Tab)
        tab.Name = tabName or "Tab"
        tab.Icon = icon
        tab.Window = self
        tab.Elements = {}
        tab.Index = #self.Tabs + 1

        local btn = mk("TextButton", {Parent=tabScroll,
            Size=UDim2.new(1,0,0,36), BackgroundColor3=t.Tab,
            BackgroundTransparency=0.4, BorderSizePixel=0, Text="",
            AutoButtonColor=false})
        crn(btn, 6)

        local iconLbl
        if icon then
            iconLbl = mk("ImageLabel", {Parent=btn, BackgroundTransparency=1,
                Position=UDim2.new(0,10,0.5,0), AnchorPoint=Vector2.new(0,0.5),
                Size=UDim2.new(0,18,0,18), Image=icon,
                ImageColor3=t.Subtitle})
        end

        local textX = icon and 36 or 14
        local lbl = mk("TextLabel", {Parent=btn, BackgroundTransparency=1,
            Position=UDim2.new(0,textX,0,0), Size=UDim2.new(1,-textX,1,0),
            Font=Enum.Font.GothamMedium, Text=tab.Name,
            TextColor3=t.Subtitle, TextSize=13,
            TextXAlignment=Enum.TextXAlignment.Left})

        local container = mk("ScrollingFrame", {Parent=content, Name=tab.Name,
            Size=UDim2.new(1,0,1,0), BackgroundTransparency=1,
            BorderSizePixel=0, ScrollBarThickness=3,
            ScrollBarImageColor3=t.Accent, CanvasSize=UDim2.new(0,0,0,0),
            AutomaticCanvasSize=Enum.AutomaticSize.Y, Visible=false,
            ScrollBarImageTransparency=0.5})
        mk("UIListLayout", {Parent=container, Padding=UDim.new(0,8),
            SortOrder=Enum.SortOrder.LayoutOrder})
        pad(container, 12, 12, 12, 12)

        tab.Button = btn
        tab.Label = lbl
        tab.Icon = iconLbl
        tab.Container = container

        btn.MouseEnter:Connect(function()
            if self.ActiveTab ~= tab then
                tw(lbl, Tween.Fast, {TextColor3=t.TextColor})
                if iconLbl then tw(iconLbl, Tween.Fast, {ImageColor3=t.TextColor}) end
                tw(btn, Tween.Fast, {BackgroundTransparency=0.2})
            end
        end)
        btn.MouseLeave:Connect(function()
            if self.ActiveTab ~= tab then
                tw(lbl, Tween.Fast, {TextColor3=t.Subtitle})
                if iconLbl then tw(iconLbl, Tween.Fast, {ImageColor3=t.Subtitle}) end
                tw(btn, Tween.Fast, {BackgroundTransparency=0.4})
            end
        end)
        btn.MouseButton1Click:Connect(function() self:SelectTab(tab) end)

        table.insert(self.Tabs, tab)
        if #self.Tabs == 1 then self:SelectTab(tab) end
        return tab
    end

    function Window:SelectTab(tab)
        if self.ActiveTab == tab then return end
        local prev = self.ActiveTab
        self.ActiveTab = tab

        if prev then
            tw(prev.Label, Tween.Fast, {TextColor3=t.Subtitle})
            if prev.Icon then tw(prev.Icon, Tween.Fast, {ImageColor3=t.Subtitle}) end
            tw(prev.Button, Tween.Fast, {BackgroundTransparency=0.4, BackgroundColor3=t.Tab})
            if prev.Container.Visible then
                tw(prev.Container, Tween.Fast, {Position=UDim2.new(0,-10,0,0)})
                task.wait(0.06)
                prev.Container.Visible = false
                prev.Container.Position = UDim2.new(0,0,0,0)
            end
        end

        tw(tab.Label, Tween.Fast, {TextColor3=t.Title})
        if tab.Icon then tw(tab.Icon, Tween.Fast, {ImageColor3=t.Accent}) end
        tw(tab.Button, Tween.Fast, {BackgroundTransparency=0, BackgroundColor3=t.Tab})
        tab.Container.Visible = true
        tab.Container.Position = UDim2.new(0,10,0,0)
        tw(tab.Container, Tween.Normal, {Position=UDim2.new(0,0,0,0)})
    end

    function Window:ToggleMinimize()
        self.Minimized = not self.Minimized
        if self.Minimized then
            win.LastSize = main.Size
            tw(main, Tween.Slow, {Size=UDim2.new(0,600,0,46)})
        else
            tw(main, Tween.Slow, {Size=win.LastSize or UDim2.new(0,600,0,420)})
        end
    end

    local dragging, dragStart, startPos
    topbar.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging, dragStart, startPos = true, i.Position, main.Position
        end
    end)
    topbar.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            local d = i.Position - dragStart
            main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X,
                                       startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
