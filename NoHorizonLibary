                ColorSequenceKeypoint.new(0.000, Color3.fromRGB(255,0,0)),
                ColorSequenceKeypoint.new(0.167, Color3.fromRGB(255,255,0)),
                ColorSequenceKeypoint.new(0.333, Color3.fromRGB(0,255,0)),
                ColorSequenceKeypoint.new(0.500, Color3.fromRGB(0,255,255)),
                ColorSequenceKeypoint.new(0.667, Color3.fromRGB(0,0,255)),
                ColorSequenceKeypoint.new(0.833, Color3.fromRGB(255,0,255)),
                ColorSequenceKeypoint.new(1.000, Color3.fromRGB(255,0,0)),
            })})
        local hueCursor = mk("Frame", {Parent=hueBar,
            AnchorPoint=Vector2.new(0.5,0.5), Position=UDim2.new(h,0,0.5,0),
            Size=UDim2.new(0,8,0,16), BackgroundColor3=Color3.new(1,1,1),
            BorderSizePixel=0, ZIndex=2})
        crn(hueCursor, 3); str(hueCursor, Color3.new(0,0,0), 1)

        local hexBox = mk("TextBox", {Parent=pickerHolder,
            Position=UDim2.new(0,10,0,104), Size=UDim2.new(1,-20,0,20),
            BackgroundColor3=t.Dropdown, BorderSizePixel=0,
            Font=Enum.Font.Code, Text="#FFFFFF", TextColor3=t.TextColor,
            TextSize=11, ClearTextOnFocus=false})
        crn(hexBox, 4); pad(hexBox, 0,0,6,0)

        local function commit()
            color = Color3.fromHSV(h, s, v)
            preview.BackgroundColor3 = color
            hexBox.Text = "#" .. string.format("%02X%02X%02X",
                color.R*255, color.G*255, color.B*255)
            if cfg.Flag then NoHorizon.Flags[cfg.Flag] = color end
            safe(cfg.Callback, color)
        end

        hexBox.FocusLost:Connect(function()
            local hex = hexBox.Text:gsub("#","")
            if #hex == 6 then
                local ok, r, g, b = pcall(function()
                    return tonumber(hex:sub(1,2),16), tonumber(hex:sub(3,4),16), tonumber(hex:sub(5,6),16)
                end)
                if ok and r and g and b then
                    color = Color3.fromRGB(r,g,b)
                    h,s,v = Color3.toHSV(color)
                    preview.BackgroundColor3 = color
                    svArea.BackgroundColor3 = Color3.fromHSV(h,1,1)
                    svCursor.Position = UDim2.new(s,0,1-v,0)
                    hueCursor.Position = UDim2.new(h,0,0.5,0)
                    commit()
                end
            end
        end)

        local svDrag, hDrag = false, false
        svArea.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                svDrag = true
            end
        end)
        hueBar.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                hDrag = true
            end
        end)
        UIS.InputChanged:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch then
                if svDrag then
                    local rx = math.clamp((i.Position.X - svArea.AbsolutePosition.X)/svArea.AbsoluteSize.X, 0, 1)
                    local ry = math.clamp((i.Position.Y - svArea.AbsolutePosition.Y)/svArea.AbsoluteSize.Y, 0, 1)
                    s, v = rx, 1-ry
                    svCursor.Position = UDim2.new(s,0,1-v,0)
                    commit()
                end
                if hDrag then
                    local rx = math.clamp((i.Position.X - hueBar.AbsolutePosition.X)/hueBar.AbsoluteSize.X, 0, 1)
                    h = rx
                    hueCursor.Position = UDim2.new(h,0,0.5,0)
                    svArea.BackgroundColor3 = Color3.fromHSV(h,1,1)
                    commit()
                end
            end
        end)
        UIS.InputEnded:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                svDrag, hDrag = false, false
            end
        end)

        preview.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 then
                open = not open
                if open then
                    pickerHolder.Visible = true
                    holder:TweenSize(UDim2.new(1,-8,0,138), Enum.EasingDirection.Out, Enum.EasingStyle.Quart, 0.2, true)
                    tw(pickerHolder, Tween.Normal, {Size=UDim2.new(1,0,0,130)})
                else
                    tw(pickerHolder, Tween.Normal, {Size=UDim2.new(1,0,0,0)})
                    holder:TweenSize(UDim2.new(1,-8,0,38), Enum.EasingDirection.Out, Enum.EasingStyle.Quart, 0.2, true)
                    task.wait(0.22); pickerHolder.Visible = false
                end
            end
        end)

        return {
            Frame=holder,
            Set=function(_, c)
                color = c; h,s,v = Color3.toHSV(c)
                preview.BackgroundColor3 = c
                svArea.BackgroundColor3 = Color3.fromHSV(h,1,1)
                svCursor.Position = UDim2.new(s,0,1-v,0)
                hueCursor.Position = UDim2.new(h,0,0.5,0)
                hexBox.Text = "#" .. string.format("%02X%02X%02X", c.R*255, c.G*255, c.B*255)
            end,
            Get=function() return color end,
        }
    end

    -- SAVE MANAGER
    if cfg.ConfigurationSaving and cfg.ConfigurationSaving.Enabled then
        local folder = cfg.ConfigurationSaving.FolderName or "NoHorizon"
        local file = cfg.ConfigurationSaving.FileName or "Config"

        function Window:Save()
            if not writefile_ then
                NoHorizon:Notify({Title="Save Error", Content="Executor doesn't support writefile.", Type="error"})
                return
            end
            if isfolder_ and not isfolder_(folder) then pcall(makefolder_, folder) end
            local data = {}
            for k, v in pairs(NoHorizon.Flags) do
                if typeof(v) == "Color3" then data[k] = {__t="c3", r=v.R,g=v.G,b=v.B}
                elseif typeof(v) == "EnumItem" then data[k] = {__t="e", e=tostring(v.EnumType), n=v.Name}
                else data[k] = v end
            end
            local ok, encoded = pcall(Http.JSONEncode, Http, data)
            if not ok then return end
            local ok2 = pcall(writefile_, folder .. "/" .. file .. ".json", encoded)
            if ok2 then NoHorizon:Notify({Title="Saved", Content=file .. " saved.", Type="success"}) end
        end

        function Window:Load()
            if not readfile_ or not isfile_ then
                NoHorizon:Notify({Title="Load Error", Content="Executor doesn't support readfile.", Type="error"})
                return
            end
            local path = folder .. "/" .. file .. ".json"
            if not isfile_(path) then
                NoHorizon:Notify({Title="Not Found", Content=file .. " doesn't exist.", Type="warning"})
                return
            end
            local ok, content = pcall(readfile_, path)
            if not ok then return end
            local ok2, data = pcall(Http.JSONDecode, Http, content)
            if not ok2 then return end
            for k, v in pairs(data) do
                if type(v) == "table" and v.__t == "c3" then NoHorizon.Flags[k] = Color3.new(v.r,v.g,v.b)
                elseif type(v) == "table" and v.__t == "e" then
                    local okE, enum = pcall(function() return Enum[v.e][v.n] end)
                    if okE then NoHorizon.Flags[k] = enum end
                else NoHorizon.Flags[k] = v end
            end
            NoHorizon:Notify({Title="Loaded", Content=file .. " loaded.", Type="success"})
        end
    end

    -- WATERMARK
    local wm = mk("Frame", {Parent=ScreenGui, Name="Watermark",
        AnchorPoint=Vector2.new(0,1), Position=UDim2.new(0,12,1,-12),
        Size=UDim2.new(0,170,0,24), BackgroundColor3=t.Topbar,
        BorderSizePixel=0, ZIndex=400})
    crn(wm, 6); str(wm, t.Outline, 1)
    mk("Frame", {Parent=wm, Size=UDim2.new(0,3,1,0),
        BackgroundColor3=t.Accent, BorderSizePixel=0})
    mk("TextLabel", {Parent=wm, BackgroundTransparency=1,
        Position=UDim2.new(0,10,0,0), Size=UDim2.new(1,-14,1,0),
        Font=Enum.Font.GothamBold, Text=name .. " • v" .. NoHorizon.Version,
        TextColor3=t.TextColor, TextSize=11,
        TextXAlignment=Enum.TextXAlignment.Left})

    local wmDrag, wmStart, wmPos
    wm.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            wmDrag, wmStart, wmPos = true, i.Position, wm.Position
        end
    end)
    wm.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then wmDrag = false end
    end)
    UIS.InputChanged:Connect(function(i)
        if wmDrag and i.UserInputType == Enum.UserInputType.MouseMovement then
            local d = i.Position - wmStart
            wm.Position = UDim2.new(wmPos.X.Scale, wmPos.X.Offset + d.X,
                                     wmPos.Y.Scale, wmPos.Y.Offset + d.Y)
        end
    end)

    return win
end

function NoHorizon:GetFlag(name) return self.Flags[name] end
function NoHorizon:SetFlag(name, v) self.Flags[name] = v end
function NoHorizon:Destroy() if self.ScreenGui then pcall(function() self.ScreenGui:Destroy() end) end end

return NoHorizon
